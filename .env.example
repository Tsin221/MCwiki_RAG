# DeepSeek is called by the backend only. Never place the real key in frontend/.
DEEPSEEK_API_KEY=replace-with-local-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# The credentialed browser origin must be explicit; "*" is not allowed.
FRONTEND_ORIGIN=http://localhost:5173

# Keep false for local HTTP development. Set true behind production HTTPS.
MCWIKI_COOKIE_SECURE=false

# Give MCwiki its own Qdrant host port. Docker maps 127.0.0.1:6335 to container port 6333.
MCWIKI_QDRANT_URL=http://127.0.0.1:6335
MCWIKI_QDRANT_COLLECTION=mcwiki_chunks
MCWIKI_VECTOR_SIZE=1024
MCWIKI_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Optional retrieval and answer budgets. Keep these defaults for the fixed 18-case baseline.
MCWIKI_BM25_LIMIT=20
MCWIKI_SEMANTIC_LIMIT=20
MCWIKI_EVIDENCE_LIMIT=8
MCWIKI_CONTEXT_BUDGET=12000
MCWIKI_EVIDENCE_STRATEGY=adjacent_merge

# Query planning. Keep "original" for the fixed 18-case baseline; "step_back" asks the model
# for one abstract background question per request and merges both rankings by rank (RRF).
MCWIKI_QUERY_STRATEGY=original
MCWIKI_MAX_RETRIEVAL_QUERIES=2
MCWIKI_QUERY_PLAN_TIMEOUT=15
# Model thinking added ~7s per planning call in local measurements without improving the
# abstract question; enable it only if the 18-case regression shows a real gain.
MCWIKI_QUERY_PLAN_THINKING_TYPE=disabled

MCWIKI_DEEPSEEK_READ_TIMEOUT=90
MCWIKI_ANSWER_TEMPERATURE=0.2
MCWIKI_ANSWER_THINKING_TYPE=disabled
MCWIKI_COOKIE_MAX_AGE=15552000
# MCWIKI_BM25_DB_PATH defaults to data/processed/bm25.db in this repository.
