# Python environments and caches
**/.venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
code/.idea/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem

# Generated SQLite indexes and sidecar files
data/processed/*.db
data/processed/*.db-*

# Regenerable chunk corpus (~68 MB). Rebuild it locally from
# data/original_dataset.json with the chunking command in RAG_ASSISTANT_GUIDE.md.
data/processed/chunks.jsonl

# Test and runtime leftovers
code/tests/tmp*/
*.log

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/*.tsbuildinfo
.playwright-cli/
